{% extends 'base.html.twig' %}
{% import ui_theme as ui %}
{% block title %}{{ 'password_reset.title'|trans }} · Nurschool{% endblock %}
{% block javascripts %}<script type="module" src="/assets/password-reset.js"></script>{% endblock %}
{% block body %}
<section id="password-reset-app" class="{{ ui.classes('panel') }} login-panel"
    data-messages="{{ {
        'password_reset.requested': 'password_reset.requested'|trans,
        'password_reset.success': 'password_reset.success'|trans,
        'password_reset.mismatch': 'password_reset.mismatch'|trans,
        'password_reset.error': 'password_reset.error'|trans
    }|json_encode|e('html_attr') }}">
    <h1 class="{{ ui.classes('title') }}">{{ 'password_reset.title'|trans }}</h1>
    <p v-cloak v-if="resetting">{{ 'password_reset.reset_help'|trans }}</p>
    <p v-cloak v-else>{{ 'password_reset.help'|trans }}</p>
    <noscript>{{ 'login.javascript'|trans }}</noscript>
    <form @submit.prevent="submit" v-cloak v-if="!success" :aria-busy="loading">
        <div v-if="!resetting" class="{{ ui.classes('field') }}">
            <label class="{{ ui.classes('label') }}" for="email">{{ 'login.email'|trans }}</label>
            <input class="{{ ui.classes('input') }}" id="email" type="email" autocomplete="email" maxlength="180" required v-model="email" :disabled="loading">
        </div>
        <template v-else>
            <div class="{{ ui.classes('field') }}">
                <label class="{{ ui.classes('label') }}" for="password">{{ 'login.password'|trans }}</label>
                <input class="{{ ui.classes('input') }}" id="password" type="password" autocomplete="new-password" minlength="12" maxlength="72" required v-model="password" :disabled="loading" aria-describedby="password-help">
                <p id="password-help">{{ 'registration.password_help'|trans }}</p>
            </div>
            <div class="{{ ui.classes('field') }}">
                <label class="{{ ui.classes('label') }}" for="confirmation">{{ 'password_reset.confirmation'|trans }}</label>
                <input class="{{ ui.classes('input') }}" id="confirmation" type="password" autocomplete="new-password" required v-model="confirmation" :disabled="loading">
            </div>
        </template>
        <p v-if="error" role="alert" class="{{ ui.classes('error') }}" v-text="error"></p>
        <button class="{{ ui.classes('primaryButton') }}" type="submit" :disabled="loading">
            <span v-if="resetting">{{ 'password_reset.submit'|trans }}</span><span v-else>{{ 'password_reset.request'|trans }}</span>
        </button>
    </form>
    <p v-if="success" v-cloak role="status" class="{{ ui.classes('info') }}" v-text="success"></p>
    <p v-if="resetting && error" v-cloak><a href="{{ path('nurschool_forgot_password') }}">{{ 'password_reset.request_again'|trans }}</a></p>
    <a href="{{ path('nurschool_login') }}">{{ 'login.title'|trans }}</a>
</section>
{% endblock %}

# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=
APP_SECRET=ChangeMe
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost:8080
###< symfony/routing ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=ChangeMe
###< lexik/jwt-authentication-bundle ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
DATABASE_NAME=ChangeMe
DATABASE_USER=ChangeMe
DATABASE_PASSWORD=ChangeMe
DATABASE_ROOT_PASSWORD=ChangeMe
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
DATABASE_URL="mysql://${DATABASE_USER}:${DATABASE_PASSWORD}@127.0.0.1:3306/${DATABASE_NAME}?serverVersion=mariadb-11.4.0&charset=utf8mb4"
# DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

# Configure a real transport and public HTTPS origin in production.
MAILER_DSN=null://null
MAILER_FROM=no-reply@nurschool.example
REGISTRATION_BASE_URL=http://localhost:8080
REGISTRATION_TTL=604800

# For real dynamic template delivery, replace MAILER_DSN above:
# MAILER_DSN=sendgrid+dynamic://YOUR_URL_ENCODED_API_KEY@default
SENDGRID_VERIFICATION_TEMPLATE_ES=ChangeMe
SENDGRID_VERIFICATION_TEMPLATE_EN=ChangeMe

# Password reset token lifetime in seconds (one hour by default).
PASSWORD_RESET_TTL=3600
PASSWORD_RESET_BASE_URL=http://localhost:8080
SENDGRID_PASSWORD_RESET_TEMPLATE_ES=ChangeMe
SENDGRID_PASSWORD_RESET_TEMPLATE_EN=ChangeMe

# Requests per normalized email in a fixed window starting with the first request.
PASSWORD_RESET_REQUEST_LIMIT=3
PASSWORD_RESET_REQUEST_INTERVAL="1 hour"

# Password-change submissions per client IP, including invalid tokens and payloads.
PASSWORD_RESET_SUBMISSION_LIMIT=10
PASSWORD_RESET_SUBMISSION_INTERVAL="15 minutes"

# OAuth applications: register the exact callbacks documented in README.md.
OAUTH_BASE_URL=http://localhost:8080
OAUTH_GOOGLE_CLIENT_ID=ChangeMe
OAUTH_GOOGLE_CLIENT_SECRET=ChangeMe
OAUTH_FACEBOOK_CLIENT_ID=ChangeMe
OAUTH_FACEBOOK_CLIENT_SECRET=ChangeMe
OAUTH_FACEBOOK_VERSION=v23.0

# Local filesystem lock store for concurrency-safe request counters.
LOCK_DSN=flock

# Required: base64-encoded random 32-byte key, shared by producers and workers.
# Generate with: php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
QUEUE_ENCRYPTION_KEY=
